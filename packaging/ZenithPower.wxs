<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" 
           Name="ZenithPower Smart Hardware Governor" 
           Language="1033" 
           Version="1.0.0.0" 
           Manufacturer="ZenithPower" 
           UpgradeCode="9F5E487C-0C3D-4A42-998C-3D45AC0E3E88">
    
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of ZenithPower is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="ZenithPower Application" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ZenithPower" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ZenithPower" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="7B9114D3-5A3E-454E-9BE2-29D5B48B90A1">
        <Shortcut Id="ApplicationStartMenuShortcut" 
                  Name="ZenithPower" 
                  Description="Smart Windows CPU and GPU Power and Voltage Governor"
                  Target="[INSTALLFOLDER]ZenithPower.UI.exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\ZenithPower" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="3F80277E-971A-4835-901D-2C5E8F8C8A33">
        <File Id="ZenithPowerExe" Source="$(var.PublishDir)\ZenithPower.UI.exe" KeyPath="yes" Checksum="yes"/>
      </Component>
    </ComponentGroup>
  </Product>
</Wix>
