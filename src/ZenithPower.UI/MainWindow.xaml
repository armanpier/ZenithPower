<Window x:Class="ZenithPower.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ZenithPower.UI.ViewModels"
        mc:Ignorable="d"
        Title="ZenithPower — CPU Power, Frequency &amp; Voltage Governor"
        Height="840" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17" Foreground="#E2E8F0"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Harmonious Modern Theme Colors -->
        <Color x:Key="BgBase">#0B0F17</Color>
        <Color x:Key="BgCard">#131924</Color>
        <Color x:Key="BgCardHover">#1A2332</Color>
        <Color x:Key="BorderBase">#1F2937</Color>
        <Color x:Key="BorderHover">#374151</Color>

        <!-- Profile Accent Colors -->
        <Color x:Key="AccentSuperSaver">#10B981</Color>
        <Color x:Key="AccentSaver">#06B6D4</Color>
        <Color x:Key="AccentNormal">#38BDF8</Color>
        <Color x:Key="AccentPerformance">#818CF8</Color>
        <Color x:Key="AccentUltimate">#F43F5E</Color>
        <Color x:Key="AccentAmber">#F59E0B</Color>

        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
        <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHover}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderBase}"/>
        <SolidColorBrush x:Key="AccentSuperSaverBrush" Color="{StaticResource AccentSuperSaver}"/>
        <SolidColorBrush x:Key="AccentSaverBrush" Color="{StaticResource AccentSaver}"/>
        <SolidColorBrush x:Key="AccentNormalBrush" Color="{StaticResource AccentNormal}"/>
        <SolidColorBrush x:Key="AccentPerformanceBrush" Color="{StaticResource AccentPerformance}"/>
        <SolidColorBrush x:Key="AccentUltimateBrush" Color="{StaticResource AccentUltimate}"/>
        <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmber}"/>

        <!-- Card Container Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- Metric Typography -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- TabItem Clean Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,12,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentNormalBrush}"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Pill Button Style -->
        <Style x:Key="PresetPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#131924"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Alert Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="#0F1520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Brand -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="⚡ ZENITH" Foreground="{StaticResource AccentNormalBrush}" FontSize="19" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock Text="POWER" Foreground="#F8FAFC" FontSize="19" FontWeight="Black" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#047857" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CPU GOVERNOR" Foreground="#ECFDF5" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Hardware Identity -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Processor: " Foreground="#94A3B8" FontSize="13"/>
                    <TextBlock Text="{Binding CpuName}" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text=" • " Foreground="#64748B" FontSize="13"/>
                    <TextBlock Text="{Binding PhysicalCoreCount, StringFormat='{}{0} Cores'}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text=" / " Foreground="#64748B" FontSize="13"/>
                    <TextBlock Text="{Binding LogicalCoreCount, StringFormat='{}{0} Threads'}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <!-- Safe Mock Mode Toggle -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Simulation Mode:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <CheckBox IsChecked="{Binding IsMockMode}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SYSTEM ALERT BANNER -->
        <Border Grid.Row="1" Background="#1A202C" BorderBrush="{StaticResource AccentAmberBrush}" BorderThickness="0,0,0,1" Padding="14,8"
                Visibility="{Binding HasAlert, Converter={x:Null}}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️ " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SystemAlert}" Foreground="#FBBF24" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Dismiss" Command="{Binding DismissAlertCommand}" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT WITH TABS -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="14,8">
            <!-- TAB 1: DASHBOARD & CPU POWER PROFILES -->
            <TabItem Header="CPU Profiles &amp; Controls">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6">
                        <!-- REAL-TIME TELEMETRY METRIC CARDS -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Live CPU Clock Speed -->
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="LIVE CPU CLOCK FREQUENCY" Style="{StaticResource MetricLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding EffectiveMhz, StringFormat='{}{0:F0}'}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentNormalBrush}"/>
                                        <TextBlock Text=" MHz" Style="{StaticResource MetricValue}" Foreground="#64748B" FontSize="15" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding NominalMhz, StringFormat='{}Target Cap: {0:F0} MHz'}" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- CPU Load & Stretching -->
                            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="CPU LOAD &amp; STRETCHING" Style="{StaticResource MetricLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0:F1}%'}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentSuperSaverBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ClockStretchingStatus}" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- CPU Power & Temp -->
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="PACKAGE POWER &amp; TEMP" Style="{StaticResource MetricLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding CpuPowerW, StringFormat='{}{0:F0}W'}" Style="{StaticResource MetricValue}"/>
                                        <TextBlock Text=" • " Style="{StaticResource MetricValue}" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding CpuTempC, StringFormat='{}{0:F0}°C'}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentAmberBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Dynamic Thermal &amp; Watt Draw" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Active Throttle Limit -->
                            <Border Grid.Column="3" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="THROTTLE LIMIT (CAP)" Style="{StaticResource MetricLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding CurrentThrottleMaxPercent, StringFormat='{}{0}%'}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentPerformanceBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentThrottleMinPercent, StringFormat='{}Min Idle P-State: {0}%'}" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- POWER PROFILE SELECTOR WITH ACTIVE HIGHLIGHTS -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="SELECT ACTIVE CPU POWER PROFILE" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Super Saver -->
                                    <Button Grid.Column="0" Margin="4" Cursor="Hand" Command="{Binding SelectProfileCommand}" CommandParameter="SuperSaver">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#131924"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="12,12"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuperSaverSelected}" Value="True">
                                                        <Setter Property="Background" Value="#0A2219"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentSuperSaverBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🍃 SUPER SAVER" Foreground="{StaticResource AccentSuperSaverBrush}" FontWeight="Bold" FontSize="13"/>
                                                <Border Background="{StaticResource AccentSuperSaverBrush}" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right"
                                                        Visibility="{Binding IsSuperSaverSelected, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="● ACTIVE" Foreground="#022C22" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Caps frequency to 65%, boost disabled, cold idle, instant burst." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Saver -->
                                    <Button Grid.Column="1" Margin="4" Cursor="Hand" Command="{Binding SelectProfileCommand}" CommandParameter="Saver">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#131924"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="12,12"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSaverSelected}" Value="True">
                                                        <Setter Property="Background" Value="#082228"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentSaverBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🌱 SAVER" Foreground="{StaticResource AccentSaverBrush}" FontWeight="Bold" FontSize="13"/>
                                                <Border Background="{StaticResource AccentSaverBrush}" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right"
                                                        Visibility="{Binding IsSaverSelected, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="● ACTIVE" Foreground="#083344" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Caps frequency to 85%, efficient boost, balanced power." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 3. Normal -->
                                    <Button Grid.Column="2" Margin="4" Cursor="Hand" Command="{Binding SelectProfileCommand}" CommandParameter="Normal">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#131924"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="12,12"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNormalSelected}" Value="True">
                                                        <Setter Property="Background" Value="#0C2038"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentNormalBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="⚖️ NORMAL" Foreground="{StaticResource AccentNormalBrush}" FontWeight="Bold" FontSize="13"/>
                                                <Border Background="{StaticResource AccentNormalBrush}" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right"
                                                        Visibility="{Binding IsNormalSelected, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="● ACTIVE" Foreground="#082F49" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="100% clock cap, standard boost, balanced responsive scaling." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 4. Performance -->
                                    <Button Grid.Column="3" Margin="4" Cursor="Hand" Command="{Binding SelectProfileCommand}" CommandParameter="Performance">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#131924"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="12,12"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPerformanceSelected}" Value="True">
                                                        <Setter Property="Background" Value="#171633"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentPerformanceBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🚀 PERFORMANCE" Foreground="{StaticResource AccentPerformanceBrush}" FontWeight="Bold" FontSize="13"/>
                                                <Border Background="{StaticResource AccentPerformanceBrush}" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right"
                                                        Visibility="{Binding IsPerformanceSelected, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="● ACTIVE" Foreground="#1E1B4B" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="100% clock cap, aggressive boost, EPP 20 quick ramp." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 5. Ultimate Performance -->
                                    <Button Grid.Column="4" Margin="4" Cursor="Hand" Command="{Binding SelectProfileCommand}" CommandParameter="UltimatePerformance">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#131924"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="12,12"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUltimateSelected}" Value="True">
                                                        <Setter Property="Background" Value="#290E18"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentUltimateBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="🔥 ULTIMATE" Foreground="{StaticResource AccentUltimateBrush}" FontWeight="Bold" FontSize="13"/>
                                                <Border Background="{StaticResource AccentUltimateBrush}" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right"
                                                        Visibility="{Binding IsUltimateSelected, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="● ACTIVE" Foreground="#4C0519" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="100% clock cap, 100% min P-state locked, zero downclock delay, EPP 0." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- WORKLOAD TARGET TUNING & MANUAL SLIDERS -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Workload Presets with Active Highlighting -->
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="WORKLOAD TARGET TUNING" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <!-- Gaming -->
                                        <Button Content="🎮 Gaming (Burst Boost)" Command="{Binding SelectPresetCommand}" CommandParameter="Gaming"
                                                Style="{StaticResource PresetPillStyle}">
                                            <Button.Triggers>
                                            </Button.Triggers>
                                        </Button>

                                        <!-- Rendering -->
                                        <Button Content="🎨 Rendering (All-Core Sustained)" Command="{Binding SelectPresetCommand}" CommandParameter="Rendering"
                                                Style="{StaticResource PresetPillStyle}"/>

                                        <!-- Single-Threaded -->
                                        <Button Content="⚡ Single-Threaded Burst" Command="{Binding SelectPresetCommand}" CommandParameter="SingleThreaded"
                                                Style="{StaticResource PresetPillStyle}"/>

                                        <!-- Turbo -->
                                        <Button Content="💥 Turbo (Maximum Throttle &amp; Boost)" Command="{Binding SelectPresetCommand}" CommandParameter="Turbo"
                                                Style="{StaticResource PresetPillStyle}"/>
                                    </WrapPanel>

                                    <!-- Workload Preset Selection Status Badge -->
                                    <Border Background="#1A2332" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="4,12,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Active Target Preset: " Foreground="#94A3B8" FontSize="12"/>
                                            <TextBlock Text="{Binding SelectedWorkloadPreset}" Foreground="{StaticResource AccentNormalBrush}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text=" (Automatically tunes Boost Mode &amp; EPP responsiveness)" Foreground="#64748B" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Manual CPU Sliders -->
                            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="MANUAL CPU GOVERNOR CONTROLS" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    
                                    <!-- Throttle Max % Slider -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Max Frequency Cap (%):" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="20" Maximum="100" Value="{Binding CurrentThrottleMaxPercent}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentThrottleMaxPercent, StringFormat='{}{0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentNormalBrush}"/>
                                    </Grid>

                                    <!-- Throttle Min % Slider -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Min Idle State (%):" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="5" Maximum="100" Value="{Binding CurrentThrottleMinPercent}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentThrottleMinPercent, StringFormat='{}{0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    </Grid>

                                    <!-- EPP Slider -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Energy Perf Preference (EPP):" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurrentEpp}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentEpp}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    </Grid>

                                    <!-- Increase Threshold Slider -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ramp-Up Threshold (%):" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="5" Maximum="95" Value="{Binding CurrentIncreaseThreshold}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentIncreaseThreshold, StringFormat='{}{0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: PER-CORE CURVE OPTIMIZER -->
            <TabItem Header="Per-Core Curve Optimizer">
                <Grid Margin="0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="PER-CORE CPU CURVE OPTIMIZER — PHYSICAL CORE TOPOLOGY" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="AMD CPPC Preferred Cores (★) achieve the highest boost clocks and are guarded with conservative offsets. Secondary cores receive negative offsets to lower package power and temperatures." Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="⚡ Auto-Tune All Cores" Command="{Binding AutoTuneAllCoresCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8"
                                    Background="#059669" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Cores ScrollViewer -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cores}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F1520" CornerRadius="6" Padding="12,8" Margin="0,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Core Index, Threads & Star Badge -->
                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CoreIndex, StringFormat='{}Core {0}'}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13"/>
                                                    <TextBlock Text="{Binding LogicalThreadsLabel, StringFormat='{} ({0})'}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    <Border Visibility="{Binding IsStarCore, Converter={StaticResource BoolToVis}}" 
                                                            Background="{StaticResource AccentAmberBrush}" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StarBadgeText}" Foreground="#0F1520" FontSize="9" FontWeight="Black"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- CPPC Hardware Rating & Clocks -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding MaxPerfRating, StringFormat='{}CPPC: {0}%'}" Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold" FontSize="11"/>
                                                        <TextBlock Text=" • " Foreground="#475569" FontSize="11"/>
                                                        <TextBlock Text="{Binding NominalMhz, StringFormat='{}Cap: {0:F0}MHz'}" Foreground="#64748B" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding EffectiveMhz, StringFormat='{}Current: {0:F0} MHz'}" Foreground="{StaticResource AccentNormalBrush}" FontWeight="Bold" FontSize="12" Margin="0,1,0,0"/>
                                                </StackPanel>

                                                <!-- Slider for Curve Offset -->
                                                <Slider Grid.Column="2" Minimum="-30" Maximum="30" Value="{Binding CurveOffset}" VerticalAlignment="Center" Margin="10,0"/>

                                                <!-- Offset Readout -->
                                                <TextBlock Grid.Column="3" Text="{Binding CurveOffset, StringFormat='{}CO: {0}'}" 
                                                           Foreground="{StaticResource AccentSuperSaverBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <!-- Execution Status -->
                                                <TextBlock Grid.Column="4" Text="{Binding ClockStretchingRatio, StringFormat='{}{0:P0} Ratio'}" 
                                                           Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: BUILT-IN CPU BENCHMARK -->
            <TabItem Header="Built-in CPU Benchmark">
                <Grid Margin="0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar with Run Button -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="BUILT-IN HARDWARE CPU BENCHMARK &amp; STRESS ENGINE" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Runs sustained parallel floating-point computation to test real multi-core score, single-core burst throughput, and frequency scaling." Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="▶ Run CPU Benchmark" Command="{Binding StartBenchmarkCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryActionBtn}" Padding="18,10"/>
                        </Grid>
                    </Border>

                    <!-- Benchmark Score Cards -->
                    <Grid Grid.Row="1" Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Multi-Core Score -->
                        <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="MULTI-CORE SCORE" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding LastBenchmarkReport.MultiCoreScore, StringFormat='{}{0:N0}', TargetNullValue='---'}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentSuperSaverBrush}"/>
                                <TextBlock Text="All-Core Parallel Throughput" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Single-Core Score -->
                        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="SINGLE-CORE SCORE" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding LastBenchmarkReport.SingleCoreScore, StringFormat='{}{0:N0}', TargetNullValue='---'}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentNormalBrush}"/>
                                <TextBlock Text="Single-Core Peak Burst Speed" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Operations / Second -->
                        <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="OPERATIONS / SECOND" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding LastBenchmarkReport.OperationsPerSecond, StringFormat='{}{0:N0}', TargetNullValue='---'}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="{Binding LastBenchmarkReport.ExecutionSeconds, StringFormat='{}Elapsed: {0:F2} seconds'}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rating / Tier -->
                        <Border Grid.Column="3" Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="CPU PERFORMANCE TIER" Style="{StaticResource MetricLabel}"/>
                                <TextBlock Text="{Binding LastBenchmarkReport.Rating, TargetNullValue='Not Tested'}" Foreground="{StaticResource AccentAmberBrush}" FontSize="14" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding LastBenchmarkReport.ProfileName, StringFormat='{}Profile: {0}'}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Benchmark Progress & Terminal Log -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{Binding BenchmarkStatus}" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" FontSize="13"/>
                                <ProgressBar IsIndeterminate="{Binding IsBenchmarking}" Height="4" Margin="0,6,0,0" Foreground="{StaticResource AccentNormalBrush}"/>
                            </StackPanel>

                            <!-- Terminal Logs -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding BenchmarkLogs}" Background="#0B0F17" BorderBrush="{StaticResource BorderBrush}" 
                                     Foreground="#86EFAC" FontFamily="Consolas" FontSize="12" Padding="8"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: HARDWARE KNOWLEDGE BASE -->
            <TabItem Header="CPU Knowledge Base">
                <Grid Margin="0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CPU Database -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="CURATED CPU HARDWARE PROFILES" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding KnownCpus}" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Foreground="#E2E8F0"
                                      RowBackground="#0F1520" AlternatingRowBackground="#131924" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Model Name" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="*"/>
                                    <DataGridTextColumn Header="Socket" Binding="{Binding Socket}" Width="80"/>
                                    <DataGridTextColumn Header="Stock TDP" Binding="{Binding StockTdpW, StringFormat='{}{0}W'}" Width="90"/>
                                    <DataGridTextColumn Header="Eco TDP" Binding="{Binding EcoTdpW, StringFormat='{}{0}W'}" Width="80"/>
                                    <DataGridTextColumn Header="Safe Max CO" Binding="{Binding RecommendedMaxNegativeOffset}" Width="100"/>
                                    <DataGridTextColumn Header="Star Core CO" Binding="{Binding RecommendedStarCoreNegativeOffset}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- RAM Database -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="SAFE MEMORY &amp; SOC VOLTAGE SPECIFICATIONS" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding KnownMemory}" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Foreground="#E2E8F0"
                                      RowBackground="#0F1520" AlternatingRowBackground="#131924" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                                    <DataGridTextColumn Header="JEDEC Voltage" Binding="{Binding JedecVoltageV, StringFormat='{}{0:F2}V'}" Width="110"/>
                                    <DataGridTextColumn Header="XMP/EXPO Typical" Binding="{Binding XmpExpoTypicalVoltageV, StringFormat='{}{0:F2}V'}" Width="130"/>
                                    <DataGridTextColumn Header="Max Safe SoC" Binding="{Binding MaxRecommendedSocVoltageV, StringFormat='{}{0:F2}V'}" Width="120"/>
                                    <DataGridTextColumn Header="Engineering Guideline" Binding="{Binding Guideline}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#0F1520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CPU Engine: " Foreground="#94A3B8" FontSize="11"/>
                    <TextBlock Text="Active (Windows PPM + Live Clocks)" Foreground="{StaticResource AccentSuperSaverBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=" • Watchdog: " Foreground="#64748B" FontSize="11" Margin="10,0,0,0"/>
                    <TextBlock Text="Armed (Dirty Reboot &amp; 95°C Thermal Guard)" Foreground="{StaticResource AccentAmberBrush}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="ZenithPower v1.1.1 — CPU Master" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
