<Window x:Class="ZenithPower.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ZenithPower.UI.ViewModels"
        mc:Ignorable="d"
        Title="ZenithPower — Smart Hardware Governor &amp; Voltage System"
        Height="820" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117" Foreground="#F0F6FC"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Dark Theme Colors & Brushes -->
        <Color x:Key="BgDark">#0D1117</Color>
        <Color x:Key="BgCard">#161B22</Color>
        <Color x:Key="BgCardHover">#21262D</Color>
        <Color x:Key="BorderColor">#30363D</Color>
        <Color x:Key="AccentGreen">#2EA043</Color>
        <Color x:Key="AccentBlue">#58A6FF</Color>
        <Color x:Key="AccentGold">#D29922</Color>
        <Color x:Key="AccentRed">#F85149</Color>
        <Color x:Key="AccentPurple">#BC8CFF</Color>

        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
        <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHover}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
        <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGold}"/>
        <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>

        <!-- Card Container Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- Metric Header Style -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Alert Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="⚡ ZENITH" Foreground="{StaticResource AccentBlueBrush}" FontSize="20" FontWeight="Black" VerticalAlignment="Center"/>
                    <TextBlock Text="POWER" Foreground="#F0F6FC" FontSize="20" FontWeight="Black" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="#238636" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SMART GOVERNOR" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Zero-BSOD Mock Toggle -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Zero-BSOD Safe Mock Mode:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <CheckBox IsChecked="{Binding IsMockMode}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding IsMockMode, Converter={x:Null}}" 
                               Foreground="{Binding IsMockMode, Converter={x:Null}}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SYSTEM ALERT BANNER -->
        <Border Grid.Row="1" Background="#21262D" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="0,0,0,1" Padding="14,8"
                Visibility="{Binding HasAlert, Converter={x:Null}}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SystemAlert}" Foreground="#E3B341" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Dismiss" Command="{Binding DismissAlertCommand}" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT WITH TABS -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="14,10">
            <!-- TAB 1: DASHBOARD & POWER PROFILES -->
            <TabItem Header="Dashboard &amp; Profiles" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10">
                        <!-- LIVE TELEMETRY CARDS -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nominal vs Effective Clock -->
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="CPU EFFECTIVE / NOMINAL" Style="{StaticResource MetricLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding EffectiveMhz, StringFormat='{}{0:F0}'}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBlueBrush}"/>
                                        <TextBlock Text=" / " Style="{StaticResource MetricValue}" Foreground="#8B949E"/>
                                        <TextBlock Text="{Binding NominalMhz, StringFormat='{}{0:F0} MHz'}" Style="{StaticResource MetricValue}"/>
                                    </StackPanel>
                                    <TextBlock Text="APERF/MPERF Clock Cycle Rate" Foreground="#8B949E" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Clock Stretching Status -->
                            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="CLOCK STRETCHING DIAGNOSTIC" Style="{StaticResource MetricLabel}"/>
                                    <TextBlock Text="{Binding ClockStretchingStatus}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentGreenBrush}"/>
                                    <TextBlock Text="{Binding ClockStretchingRatio, StringFormat='{}Execution Ratio: {0:P1}'}" Foreground="#8B949E" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- CPU Package Power & Temp -->
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="CPU PACKAGE POWER &amp; TEMP" Style="{StaticResource MetricLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding CpuPowerW, StringFormat='{}{0:F1}W'}" Style="{StaticResource MetricValue}"/>
                                        <TextBlock Text=" • " Style="{StaticResource MetricValue}" Foreground="#8B949E"/>
                                        <TextBlock Text="{Binding CpuTempC, StringFormat='{}{0:F1}°C'}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentGoldBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Package PPT / PL1 Live Draw" Foreground="#8B949E" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- GPU Power & Temp -->
                            <Border Grid.Column="3" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="GPU POWER &amp; CLOCK" Style="{StaticResource MetricLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding GpuPowerW, StringFormat='{}{0:F1}W'}" Style="{StaticResource MetricValue}"/>
                                        <TextBlock Text=" • " Style="{StaticResource MetricValue}" Foreground="#8B949E"/>
                                        <TextBlock Text="{Binding GpuClockMhz, StringFormat='{}{0:F0}MHz'}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentPurpleBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GpuTempC, StringFormat='{}GPU Core: {0:F1}°C'}" Foreground="#8B949E" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- POWER PROFILE SELECTOR -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="SELECT ACTIVE POWER PROFILE" Foreground="#F0F6FC" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Super Saver -->
                                    <Button Grid.Column="0" Margin="4" Padding="14,12" Background="#1C2128" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="2" Cursor="Hand"
                                            Command="{Binding SelectProfileCommand}" CommandParameter="SuperSaver">
                                        <StackPanel>
                                            <TextBlock Text="🍃 SUPER SAVER" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Icy-cold idle, 35W Eco, EPP 85, instant burst response." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Saver -->
                                    <Button Grid.Column="1" Margin="4" Padding="14,12" Background="#1C2128" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                            Command="{Binding SelectProfileCommand}" CommandParameter="Saver">
                                        <StackPanel>
                                            <TextBlock Text="🌱 SAVER" Foreground="#F0F6FC" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Balanced Eco, 65W, EPP 65, efficient boost." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Normal -->
                                    <Button Grid.Column="2" Margin="4" Padding="14,12" Background="#1C2128" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                            Command="{Binding SelectProfileCommand}" CommandParameter="Normal">
                                        <StackPanel>
                                            <TextBlock Text="⚖️ NORMAL" Foreground="{StaticResource AccentBlueBrush}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Standard balanced scaling, stock TDP, safe negative baseline." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Performance -->
                                    <Button Grid.Column="3" Margin="4" Padding="14,12" Background="#1C2128" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                                            Command="{Binding SelectProfileCommand}" CommandParameter="Performance">
                                        <StackPanel>
                                            <TextBlock Text="🚀 PERFORMANCE" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="EPP 25, quick clock ramp, aggressive boost." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Ultimate Performance -->
                                    <Button Grid.Column="4" Margin="4" Padding="14,12" Background="#1C2128" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="2" Cursor="Hand"
                                            Command="{Binding SelectProfileCommand}" CommandParameter="UltimatePerformance">
                                        <StackPanel>
                                            <TextBlock Text="🔥 ULTIMATE" Foreground="{StaticResource AccentRedBrush}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="EPP 0, zero throttle delay, max unlocked board limits." Foreground="#8B949E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- WORKLOAD PRESETS & RESPONSIVENESS CONTROLS -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Workload Presets -->
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="WORKLOAD PRESET OVERLAYS" Foreground="#F0F6FC" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button Content="🎮 Gaming (Single/Dual Peak + GPU)" Command="{Binding SelectPresetCommand}" CommandParameter="Gaming"
                                                Margin="4" Padding="10,8" Background="#21262D" Foreground="#F0F6FC" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                                        <Button Content="🎨 Rendering (All-Core PPT + 85°C Cap)" Command="{Binding SelectPresetCommand}" CommandParameter="Rendering"
                                                Margin="4" Padding="10,8" Background="#21262D" Foreground="#F0F6FC" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                                        <Button Content="⚡ Single-Threaded Burst" Command="{Binding SelectPresetCommand}" CommandParameter="SingleThreaded"
                                                Margin="4" Padding="10,8" Background="#21262D" Foreground="#F0F6FC" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand"/>
                                        <Button Content="💥 Turbo (Dual Amplification)" Command="{Binding SelectPresetCommand}" CommandParameter="Turbo"
                                                Margin="4" Padding="10,8" Background="#21262D" Foreground="{StaticResource AccentGoldBrush}" BorderThickness="1" BorderBrush="{StaticResource AccentGoldBrush}" Cursor="Hand"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Responsiveness Governor Sliders -->
                            <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="RESPONSIVENESS GOVERNOR THRESHOLDS" Foreground="#F0F6FC" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                    
                                    <!-- EPP Slider -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Energy Perf Preference (EPP):" Foreground="#8B949E" VerticalAlignment="Center" Width="180"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurrentEpp}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentEpp}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Grid>

                                    <!-- Increase Threshold Slider -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Clock Ramp-Up Threshold (%):" Foreground="#8B949E" VerticalAlignment="Center" Width="180"/>
                                        <Slider Grid.Column="1" Minimum="10" Maximum="95" Value="{Binding CurrentIncreaseThreshold}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentIncreaseThreshold, StringFormat='{}{0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Grid>

                                    <!-- CPU Power Limit W -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CPU Power Limit (Watts):" Foreground="#8B949E" VerticalAlignment="Center" Width="180"/>
                                        <Slider Grid.Column="1" Minimum="25" Maximum="320" Value="{Binding CurrentCpuPowerLimitW}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentCpuPowerLimitW, StringFormat='{}{0:F0}W'}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: CURVE OPTIMIZER (PER-CORE) -->
            <TabItem Header="Curve Optimizer (Per-Core)" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="PER-CORE CURVE OPTIMIZER &amp; STAR-CORE BALANCING" Foreground="#F0F6FC" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Star Cores (★) boost to peak frequencies and are protected with safe offsets. Non-star cores receive deep negative offsets to unlock thermal and electrical power headroom." Foreground="#8B949E" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="Auto-Tune All Cores" Command="{Binding AutoTuneAllCoresCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8"
                                    Background="{StaticResource AccentGreenBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Cores ItemsControl -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cores}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#21262D" CornerRadius="6" Padding="12,10" Margin="0,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Core Name & Badge -->
                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CoreIndex, StringFormat='{}Core {0}'}" FontWeight="Bold" Foreground="#F0F6FC"/>
                                                    <Border Visibility="{Binding IsStarCore, Converter={x:Null}}" 
                                                            Background="#D29922" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="★ STAR" Foreground="Black" FontSize="9" FontWeight="Black"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Clocks -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NominalMhz, StringFormat='{}Nominal: {0:F0} MHz'}" Foreground="#8B949E" FontSize="11"/>
                                                    <TextBlock Text="{Binding EffectiveMhz, StringFormat='{}Effective: {0:F0} MHz'}" Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                </StackPanel>

                                                <!-- Slider for Curve Offset -->
                                                <Slider Grid.Column="2" Minimum="-30" Maximum="30" Value="{Binding CurveOffset}" VerticalAlignment="Center" Margin="10,0"/>

                                                <!-- Offset Readout -->
                                                <TextBlock Grid.Column="3" Text="{Binding CurveOffset, StringFormat='{}CO: {0}'}" 
                                                           Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                <!-- Execution Status -->
                                                <TextBlock Grid.Column="4" Text="{Binding ClockStretchingRatio, StringFormat='{}{0:P0} Ratio'}" 
                                                           Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: QUICK AUTO-TUNING BENCHMARK -->
            <TabItem Header="Quick Calibration Benchmark" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="AUTOMATED 3-MINUTE VOLTAGE &amp; POWER CALIBRATION" Foreground="#F0F6FC" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Probes both downclocking power-savings and peak overclocking headroom without crashing or blue-screening, using real-time APERF/MPERF clock stretching tripwires." Foreground="#8B949E" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="▶ Start Benchmark" Command="{Binding StartBenchmarkCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,10"
                                    Background="{StaticResource AccentBlueBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Benchmark Progress & Output Log -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{Binding BenchmarkStatus}" Foreground="{StaticResource AccentGoldBrush}" FontWeight="Bold" FontSize="14"/>
                                <ProgressBar IsIndeterminate="{Binding IsBenchmarking}" Height="4" Margin="0,6,0,0" Foreground="{StaticResource AccentBlueBrush}"/>
                            </StackPanel>

                            <!-- Terminal Logs -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding BenchmarkLogs}" Background="#0D1117" BorderBrush="{StaticResource BorderBrush}" 
                                     Foreground="#7EE787" FontFamily="Consolas" FontSize="12" Padding="8"/>

                            <!-- Summary Card -->
                            <Border Grid.Row="2" Background="#161B22" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                <TextBlock Text="{Binding BenchmarkSummary, TargetNullValue='No benchmark summary yet. Click Start Benchmark to run.'}" 
                                           Foreground="#F0F6FC" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: HARDWARE KNOWLEDGE BASE -->
            <TabItem Header="Hardware Database" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CPU Database -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="CURATED CPU HARDWARE PROFILES" Foreground="#F0F6FC" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding KnownCpus}" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Foreground="#F0F6FC"
                                      RowBackground="#161B22" AlternatingRowBackground="#21262D" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Model Name" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="*"/>
                                    <DataGridTextColumn Header="Socket" Binding="{Binding Socket}" Width="80"/>
                                    <DataGridTextColumn Header="Stock TDP" Binding="{Binding StockTdpW, StringFormat='{}{0}W'}" Width="90"/>
                                    <DataGridTextColumn Header="Eco TDP" Binding="{Binding EcoTdpW, StringFormat='{}{0}W'}" Width="80"/>
                                    <DataGridTextColumn Header="Safe Max CO" Binding="{Binding RecommendedMaxNegativeOffset}" Width="100"/>
                                    <DataGridTextColumn Header="Star Core CO" Binding="{Binding RecommendedStarCoreNegativeOffset}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- GPU & RAM Database -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- GPU Profiles -->
                        <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="CURATED GPU PROFILES" Foreground="#F0F6FC" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding KnownGpus}" AutoGenerateColumns="False" IsReadOnly="True" 
                                          Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Foreground="#F0F6FC"
                                          RowBackground="#161B22" AlternatingRowBackground="#21262D" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="GPU Model" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="Stock TDP" Binding="{Binding StockTdpW, StringFormat='{}{0}W'}" Width="80"/>
                                        <DataGridTextColumn Header="Eco TDP" Binding="{Binding EcoTdpW, StringFormat='{}{0}W'}" Width="80"/>
                                        <DataGridTextColumn Header="V/F Anchor" Binding="{Binding VfCurveAnchorMilliVolts, StringFormat='{}{0} mV'}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- RAM Profiles -->
                        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="SAFE MEMORY VOLTAGE STANDARDS" Foreground="#F0F6FC" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding KnownMemory}" AutoGenerateColumns="False" IsReadOnly="True" 
                                          Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Foreground="#F0F6FC"
                                          RowBackground="#161B22" AlternatingRowBackground="#21262D" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60"/>
                                        <DataGridTextColumn Header="JEDEC V" Binding="{Binding JedecVoltageV, StringFormat='{}{0:F2}V'}" Width="70"/>
                                        <DataGridTextColumn Header="XMP/EXPO V" Binding="{Binding XmpExpoTypicalVoltageV, StringFormat='{}{0:F2}V'}" Width="85"/>
                                        <DataGridTextColumn Header="Max Safe SoC" Binding="{Binding MaxRecommendedSocVoltageV, StringFormat='{}{0:F2}V'}" Width="95"/>
                                        <DataGridTextColumn Header="Guideline" Binding="{Binding Guideline}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#161B22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Governor Engine: " Foreground="#8B949E" FontSize="11"/>
                    <TextBlock Text="Active (Windows PPM + Curve Optimizer)" Foreground="{StaticResource AccentGreenBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=" • Watchdog: " Foreground="#8B949E" FontSize="11" Margin="10,0,0,0"/>
                    <TextBlock Text="Armed (Dirty Reboot &amp; 95°C Thermal Trip Protection)" Foreground="{StaticResource AccentGoldBrush}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="ZenithPower v1.0.0 — Zero-BSOD Safe" Foreground="#8B949E" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
